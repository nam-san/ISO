# 누리보이스 IMS 환경 변수 예시 파일
# 이 파일을 복사하여 .env 로 이름 변경 후 값을 채우세요
# cp .env.example .env

# Flask 보안 키 (랜덤 64자 이상 문자열로 변경 필수)
SECRET_KEY=your-secret-key-here-change-this

# 데이터베이스 경로 (기본값 사용 시 주석 유지)
# DATABASE_URL=sqlite:///instance/ims.db

# 운영 환경 (개발: development / 운영: production)
FLASK_ENV=development
FLASK_DEBUG=1

# 회사명 (선택)
# COMPANY_NAME=주식회사 누리보이스
